{
  "kind": "collectionType",
  "collectionName": "contact_requests",
  "info": {
    "singularName": "contact-request",
    "pluralName": "contact-requests",
    "displayName": "contact-request"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "interestType": {
      "type": "enumeration",
      "enum": [
        "on_demand_gpus",
        "enterprise_bare_metal",
        "weka_storage",
        "technical_support",
        "partnership",
        "other"
      ]
    },
    "fullName": {
      "type": "string"
    },
    "workEmail": {
      "type": "email"
    },
    "phoneNumber": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "budgetRange": {
      "type": "enumeration",
      "enum": [
        "under_5k",
        "range_5k_20k",
        "range_20k_100k",
        "range_100k_500k",
        "range_500k_plus"
      ]
    },
    "message": {
      "type": "text"
    },
    "progress": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "in_progress",
        "closed"
      ]
    },
    "source": {
      "type": "string"
    },
    "requestType": {
      "type": "enumeration",
      "enum": [
        "early_access",
        "general_contact"
      ],
      "default": "general_contact"
    },
    "productInterest": {
      "type": "enumeration",
      "enum": [
        "token_factory"
      ]
    },
    "modelsOfInterest": {
      "type": "text"
    },
    "endpointPreference": {
      "type": "enumeration",
      "enum": [
        "api_inference",
        "dedicated_endpoint",
        "undecided"
      ]
    },
    "expectedUsage": {
      "type": "text"
    },
    "targetStartDate": {
      "type": "date"
    },
    "interestedInGtcBerlin": {
      "type": "boolean",
      "default": false
    },
    "marketingOptIn": {
      "type": "boolean",
      "default": false
    },
    "originatingPage": {
      "type": "string"
    },
    "originatingCta": {
      "type": "string"
    },
    "utmSource": {
      "type": "string"
    },
    "utmMedium": {
      "type": "string"
    },
    "utmCampaign": {
      "type": "string"
    },
    "utmTerm": {
      "type": "string"
    },
    "utmContent": {
      "type": "string"
    }
  }
}
